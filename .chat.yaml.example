 # ==============================================================================
 # .chat.yaml - Configuration for dynamic-rag-chat
 # ==============================================================================
 #
 # Supplied command line arguments override settings here, allowing you to
 # store common arguments like server addresses, yet pass --model on the fly.
 #
 # NOTE: The values below should match the full options name (see --help) with
 #       underscores instead of dashes. (eg: context_window not context-window)
 #
 # Interesting Note: history_dir contains *everything* about your experience.
 # You can change this on a whim to have a new history/experience with your LLM,
 # and then change it back to continue past-conversations. Or, delete this
 # directory when finished to remove any trace of your conversations.
 #
 # ==============================================================================

 chat:

   # ---------------------------------------------------------------------------
   # Core Models
   # ---------------------------------------------------------------------------

   model: gemma3:27b                    # Heavy-weight LLM, your main go-to
   model_temp: 1.0
   model_topp: 0.95

   pre_llm: gemma3:1b                   # Light-weight LLM, used for metadata tagging, model
                                        # routing, etc
   pre_temp: 0.7
   pre_topp: 0.95

   embedding_llm: nomic-embed-text      # Embeddings for RAG vector database work

   # ---------------------------------------------------------------------------
   # Story-Specific Models (Optional Specializations)
   # ---------------------------------------------------------------------------

   nsfw_llm:                            # (Optional) For explicit or unfiltered storytelling
                                        #
                                        # Most models are SFW — they can handle mature themes
                                        # like violence, war, moral darkness, sensual tension,
                                        # crime, and psychological horror — but they will avoid
                                        # explicit sexual content, extreme graphic gore, or
                                        # detailed illegal instruction.
                                        #
                                        # If your story requires fully explicit sexual content,
                                        # highly graphic brutality, or other unrestricted
                                        # material, configure a dedicated NSFW-capable model.
                                        #
                                        # Some NSFW models that come to mind:
                                        #   - huihui-glm-4.6-abliterated-mlx
                                        #   - midnight-miqu-103b-v1.0
                                        #   - gemma3-27b-abliterated
                                        #
                                        # Tip: If you write primarily uncensored material, it is
                                        # often cleaner to make your NSFW model the default and
                                        # leave this option unset. The separate configuration
                                        # exists for experimentation or dynamic routing setups.
   nsfw_temp: 1.0
   nsfw_topp: 0.95

   polisher_llm:                        # (Optional) Beautiful story prose. Example:
                                        # midnight-miqu-103b-v1.0
   polisher_temp: 1.0
   polisher_topp: 0.95

   entity_llm:                          # (Optional) Story/NPC character metadata extraction
                                        # Example: qwen2.5-coder-7b-instruct
   entity_temp: 0.7
   entity_topp: 0.95

   # ---------------------------------------------------------------------------
   # Assistant Mode Models (Optional Specializations)
   # ---------------------------------------------------------------------------
   # Note: If you only use one model (model or --model), the following will
   # inherit that value (except agent and vision, so as not to break if your 'one'
   # model happens to not be tool/vision capable)

   agent_llm:                           # (Optional) Agentic tooling tasks
   agent_temp: 0.6
   agent_topp: 0.95

   vision_llm:                          # (Optional) Image processing
   vision_temp: 0.9
   vision_topp: 0.95

   casual_llm:                          # (Optional) Simple queries or comments
   casual_temp: 0.9
   casual_topp: 0.95

   general_llm:                         # (Optional) General purpose Q&A
   general_temp: 0.9
   general_topp: 0.95

   coder_llm:                           # (Optional) Coding specific tasks
   coder_temp: 0.7
   coder_topp: 0.95

   structured_llm:                      # (Optional) Analysis and reasoning
   structured_temp: 0.7
   structure_topp: 0.95

   # ---------------------------------------------------------------------------
   # Server Configuration
   # ---------------------------------------------------------------------------
   # Note: If you are running all your models on the same sever, you only then
   # need to supply llm_server (or --model-server). The rest of the models will
   # inherit that value.

   llm_server: https://api.openai.com/v1    # Or an OpenAI compatible API server address
   pre_server:                              # (OpenAI API capable server address)
   embedding_server:                        # (OpenAI API capable server address)
   rerank_llm:                              # (Optional) Cross-encoder, e.g. bge-reranker
   rerank_server:                           # (OpenAI / Edge /v1/rerank). Blank inherits llm_server.
   rerank_timeout: 8                        # Seconds to wait on the rerank POST
   polisher_server:                         # (OpenAI API capable server address)
   entity_server:                           # (OpenAI API capable server address)
   nsfw_server:                             # (OpenAI API capable server address)
   agent_server:                            # (OpenAI API capable server address)
   vision_server:                           # (OpenAI API capable server address)
   casual_server:                           # (OpenAI API capable server address)
   general_server:                          # (OpenAI API capable server address)
   coder_server:                            # (OpenAI API capable server address)
   structured_server:                       # (OpenAI API capable server address)

   # ---------------------------------------------------------------------------
   # Behavior & Tuning
   # ---------------------------------------------------------------------------

   distrust_confidence: 0.6             # Your implied distrust of the model's ability to
                                        # properly perform an internet search.
                                        #
                                        # Higher values == more agentic web searches.
                                        # Use with caution if on a paid subscription plan.

   rag_matches: 2                       # How many matches to allow from the RAG (2 from user's RAG and 2
                                        # from AI's RAG). In practice, increasing this number to large
                                        # values adds little in the quality of provided context. Low-ish
                                        # numbers are better. Even 1 is satisfactory here.

                                        # Why: RAG is what makes very long stories possible.
                                        # RAG results are *highly* targeted snippets of *relevant* context.
                                        # Say you mention an NPC by name and perhaps the weather that day...
                                        # This will allow the model access to that context regardless of when
                                        # it occurred in your turn history (hundreds... thousands of turns
                                        # ago). A good LLM will use this information and remain faithful,
                                        # truthful, and engaging.

   history_session: 9                   # How many turns of history to provide
                                        # (that's ~13 messages from all sources (2+2+9))

   unmolested_sessions: 5               # The trailing number of turns to leave alone. This system
                                        # utilizes an exponential decay method which tries to 'efficiently'
                                        # preserve earlier random context (this is important in stories).

                                        # Example(s): if history_sessions = 9 and you are on turn 20, the
                                        # following turn history will be provided:
                                        # [0, 3, 7, 11, 15, 16, 17, 18, 19]
                                        #               ^^ <----------> ^^ 5 unmolested sessions
                                        #  ^ <----> ^^ (9-5=4) exponentially decaying previous turns

                                        # If you are on turn 80:
                                        # [0, 23, 47, 71, 95, 96, 97, 98, 99]
                                        #                 ^^ <----------> ^^ 5 unmolested sessions
                                        #  ^ <------> ^^ (9-5=4) exponentially decaying previous turns

                                        # If you do not wish this feature enabled, set unmolested_sessions
                                        # to the same integer as history_sessions.

                                        # Obviously, if you are using powerful models that can handle huge
                                        # context windows, on equally powerful hardware, these numbers should
                                        # all be cranked up. The defaults above (for me on average), produce
                                        # ~32K token context sessions

   lookback: None                       # Maximum turns to use when computing above unmolested_sessions.
                                        # None == use full history. If not None, the decay is no longer
                                        # exponential; a hard floor excludes all turns prior to:
                                        # max(0, all_history - lookback). Example:

                                        # If you are on turn 80 and lookback is set to 30, the following
                                        # turn history will be provided:
                                        # [50, 56, 63, 69, 76, 77, 78, 79]
                                        #                  ^^ <------> ^^ 4 unmolested sessions
                                        #  ^ <-------> ^^ (8-4=4), 7 evenly spaced decaying previous turns

                                        # Setting loopback to a hard number may help with extremely long winded
                                        # stories (when supplying such an early turn as 0, is more a hindrance
                                        # than help). If you opt to set this, I suggest a high value

   context_window: 4192                 # Ask the server to use this context window size
                                        # (sometimes can be ignored by the server)

   seed:                                # Specify a string to hash into a 32-bit int
                                        # (useful for debugging/reproducibility)

   # ---------------------------------------------------------------------------
   # API Keys
   # ---------------------------------------------------------------------------

   api_key: YOUR_API_KEY                # Your assigned API key, or empty if using local Ollama
   tavily_key: YOUR_TAVILY_KEY          # Your assigned API key from Tavily (deep web search)
                                        # Leave empty if not using Tavily

   sd_server: http://127.0.0.1:7860     # Automatic1111 with --api. Blank disables image gen.
   sd_model:                            # Checkpoint title from A1111. Blank = whatever is loaded.

   # ---------------------------------------------------------------------------
   # UI / UX
   # ---------------------------------------------------------------------------

   time_zone: America/Denver            # Currently not used in system prompts, but easy to
                                        # implement: {date_time}

   light_mode: false                    # Set to true if you use a high luminance terminal background

   syntax_style: fruity                 # Syntax highlighting theme
                                        # See: https://pygments.org/styles/

   name: your_assistant                 # Name your assistant/story-teller

   user_name: your_character            # Use this to ground your LLMs — you are the protagonist
                                        # in your stories

   sex: male || female                  # Your character's gender (this allows pro-nouns to be filled
                                        # in templates)

   character_sheet: /path/to/file       # supply a file that contains the context of your Character Sheet
                                        # FYI: this file does NOT support templating operations. It is read
                                        # literally as-is

   assistant_mode: true                 # Use non-storytelling prompts. Useful if you're using
                                        # this chat script as a tool instead of a storyteller

   debug: false                         # Enable verbose debugging output

# Ollama server switches of note:
# I have good experiences with the above models running locally at 25+ tokens/s (Mac Studio 512GB),
# using the following Ollama environment variables set:
#
# OLLAMA_CONTEXT_LENGTH=32768
# OLLAMA_KEEP_ALIVE=24h
# OLLAMA_MAX_LOADED_MODELS=3
# OLLAMA_KV_CACHE_TYPE=f16
# OLLAMA_FLASH_ATTENTION=true
